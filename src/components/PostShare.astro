---
import Icon from '@/components/Icon.astro';

export interface Props {
  url: string;
  title: string;
  imageUrl?: string;
}

const { url, title, imageUrl = '' } = Astro.props;
const publicShareOrigin = 'https://www.soloquedalopeor.com';
const publicShareUrl = (() => {
  try {
    const shareUrl = new URL(url);
    return `${publicShareOrigin}${shareUrl.pathname}${shareUrl.search}${shareUrl.hash}`;
  } catch {
    return url;
  }
})();
const encodedUrl = encodeURIComponent(publicShareUrl);
const encodedTitle = encodeURIComponent(title);

const shareLinks = [
  {
    name: 'Facebook',
    icon: 'facebook',
    url: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}&quote=${encodedTitle}`,
  },
  {
    name: 'X',
    icon: 'x-twitter',
    url: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
  },
  {
    name: 'Bluesky',
    icon: 'bluesky',
    url: `https://bsky.app/intent/compose?text=${encodeURIComponent(`${title} ${url}`)}`,
  },
  {
    name: 'WhatsApp',
    icon: 'whatsapp',
    url: `https://api.whatsapp.com/send?text=${encodeURIComponent(`${title} ${url}`)}`,
  },
];
---

<aside class="mb-6" aria-label="Compartir este artículo">
  <div class="flex flex-wrap items-center gap-2">
    <span class="mr-1 text-xs font-semibold uppercase tracking-wide text-primary-500 dark:text-primary-400">Compartir</span>
    <div class="flex flex-wrap items-center gap-1.5">
      <button
        type="button"
        data-post-share-native
        data-share-title={title}
        data-share-url={publicShareUrl}
        data-share-image={imageUrl}
        class="inline-flex min-h-8 items-center gap-1.5 rounded-md border border-highlight-400 dark:border-highlight-500 px-2.5 py-1 text-xs font-medium text-highlight-700 dark:text-highlight-200 transition-colors hover:bg-highlight-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-highlight-400 dark:hover:bg-highlight-900 dark:focus-visible:ring-highlight-500"
        aria-label="Compartir el artículo con su imagen"
        title="Compartir el artículo con su imagen"
      >
        <Icon name="link-2" size={15} />
        <span>Con foto</span>
      </button>
      {shareLinks.map((share) => (
        <a
          href={share.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-primary-300 dark:border-primary-600 text-primary-600 dark:text-primary-300 transition-colors hover:border-highlight-400 hover:bg-highlight-100 hover:text-highlight-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-highlight-400 dark:hover:border-highlight-500 dark:hover:bg-highlight-900 dark:hover:text-highlight-200 dark:focus-visible:ring-highlight-500"
          aria-label={`Compartir en ${share.name}`}
          title={`Compartir en ${share.name}`}
        >
          <Icon name={share.icon} size={17} />
        </a>
      ))}
    </div>
  </div>
</aside>

<script is:inline>
  function initializePostShare() {
    const buttons = document.querySelectorAll('[data-post-share-native]:not([data-bound])');

    buttons.forEach((button) => {
      button.setAttribute('data-bound', 'true');
      button.addEventListener('click', async () => {
        const title = button.getAttribute('data-share-title') || document.title;
        const url = button.getAttribute('data-share-url') || window.location.href;
        const imageUrl = button.getAttribute('data-share-image');
        const shareData = { title, text: title, url };

        try {
          if (imageUrl && navigator.canShare) {
            const response = await fetch(imageUrl);
            const blob = await response.blob();
            const extension = blob.type.split('/')[1] || 'jpg';
            const file = new File([blob], `post-image.${extension}`, { type: blob.type });
            if (navigator.canShare({ files: [file] })) {
              await navigator.share({ ...shareData, files: [file] });
              return;
            }
          }

          if (navigator.share) {
            await navigator.share(shareData);
            return;
          }

          window.prompt('Copia este enlace para compartirlo:', url);
        } catch (error) {
          if (error instanceof DOMException && error.name === 'AbortError') return;
          window.prompt('Copia este enlace para compartirlo:', url);
        }
      });
    });
  }

  window.initializePostShare = initializePostShare;
  document.addEventListener('DOMContentLoaded', initializePostShare);
  initializePostShare();

  if (window.swup?.hooks) {
    window.swup.hooks.on('page:view', initializePostShare);
    window.swup.hooks.on('visit:end', initializePostShare);
  }
</script>
