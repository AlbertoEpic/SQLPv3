---
export interface Props {
  id: string;
  title: string;
  location: string;
  category: string;
  type: 'youtube' | 'iframe' | 'dgt' | 'snapshot';
  embedUrl: string;
  sourceName: string;
  sourceUrl?: string;
}

const { id, title, location, category, type, embedUrl, sourceName, sourceUrl } = Astro.props;
const src =
  type === 'youtube'
    ? `${embedUrl}${embedUrl.includes('?') ? '&' : '?'}autoplay=1&mute=1&playsinline=1`
    : embedUrl;
const isDgt = type === 'dgt';
const isSnapshot = type === 'snapshot';
const isImage = isDgt || isSnapshot;
const isEmbed = type === 'youtube' || type === 'iframe';
// Evita contenido mixto (http dentro de https)
const imgSrc = embedUrl.replace(/^http:\/\//, 'https://');
---

<article
  id={`webcam-${id}`}
  data-webcam-card
  data-category={category}
  data-type={type}
  data-title={title}
  data-location={location}
  data-media-src={isImage ? imgSrc : src}
  class="webcam-card overflow-hidden rounded-2xl border border-primary-200 bg-primary-50/80 shadow-md transition-all duration-300 hover:border-highlight-400 dark:border-primary-700 dark:bg-primary-900/62 dark:hover:border-highlight-500"
>
  <div class="relative flex aspect-video w-full items-center justify-center bg-primary-900">
    {isImage || isEmbed ? (
      <button
        type="button"
        data-webcam-expand
        aria-label={`Ampliar ${title}`}
        title="Ampliar"
        class={isImage
          ? 'absolute inset-0 z-[5] cursor-zoom-in focus:outline-none focus-visible:ring-2           focus-visible:ring-highlight-500'
                    : 'absolute right-3 top-3 z-10 rounded-full border border-white/10 bg-primary-950/75 p-1.5 text-primary-100 backdrop-blur-md transition-colors hover:text-highlight-300 focus-visible:ring-2 focus-visible:ring-highlight-500'}
      >
        {!isImage && (
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4h4M20 8V4h-4M4 16v4h4M20 16v4h-4"></path>
          </svg>
        )}
      </button>
    ) : null}
    {isDgt ? (
      <div class="absolute left-3 top-3 z-10 flex items-center gap-1.5 rounded-full       border border-white/10 bg-primary-950/75 px-2.5 py-1 backdrop-blur-md">
              <span class="h-2 w-2 rounded-full bg-highlight-400"></span>
              <span class="text-[10px] font-bold uppercase tracking-wider text-primary-50">Tráfico DGT</span>
      </div>
    ) : isSnapshot ? (
      <div class="absolute left-3 top-3 z-10 rounded-full       border border-white/10 bg-primary-950/75 px-2.5 py-1 backdrop-blur-md">
              <span class="text-[10px] font-bold uppercase tracking-wider text-primary-50">Imagen actualizada</span>
      </div>
    ) : (
      <div class="absolute left-3 top-3 z-10 flex items-center gap-1.5 rounded-full       border border-white/10 bg-primary-950/75 px-2.5 py-1 backdrop-blur-md">
        <span class="relative flex h-2.5 w-2.5">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-highlight-400 opacity-75"></span>
                <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-highlight-500"></span>
        </span>
              <span class="text-[10px] font-bold uppercase tracking-wider text-primary-50">EN DIRECTO</span>
      </div>
    )}

    {isImage ? (
      <>
        <img
          src={imgSrc}
          alt={title}
          class="h-full w-full object-cover"
          loading="lazy"
          referrerpolicy="no-referrer"
          data-webcam-refresh
          data-base-src={imgSrc}
        />
        <div data-webcam-fallback class="absolute inset-0 hidden items-center justify-center bg-primary-900 text-xs text-primary-300">
          Cámara no disponible
        </div>
      </>
    ) : isEmbed ? (
      <iframe
        src={src}
        title={title}
        class="h-full w-full border-0"
        loading="lazy"
        allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    ) : (
      <div class="text-xs text-primary-300">Emisión no disponible</div>
    )}
  </div>

  <div class="p-4">
    <div class="mb-2 flex items-start justify-between gap-2">
      <h3 class="text-base font-bold       leading-snug text-primary-900 dark:text-primary-50">{title}</h3>
            <span class="whitespace-nowrap rounded border border-highlight-500/30 bg-highlight-100 px-2 py-0.5 text-[11px] font-semibold text-highlight-700 dark:bg-primary-800 dark:text-highlight-300">
        {category}
      </span>
    </div>
    <div class="mt-2 flex items-center justify-between gap-2     text-xs text-primary-700 dark:text-primary-200">
      <p class="flex items-center gap-1">
            <svg class="h-3.5 w-3.5 shrink-0 text-highlight-600 dark:text-highlight-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <span>{location}</span>
      </p>
      {sourceName && (
        sourceUrl ? (
          <a
            href={sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="truncate text-[10px] text-primary-600 hover:text-highlight-700 dark:text-primary-300 dark:hover:text-highlight-300"
          >
            Fuente: {sourceName}
          </a>
        ) : (
          <span class="truncate text-[10px] text-primary-600 dark:text-primary-300">Fuente: {sourceName}</span>
        )
      )}
    </div>
  </div>
</article>

<style is:global>
  .webcam-card.webcam-highlight {
    box-shadow: 0 0 0 2px #f59e0b, 0 0 24px rgba(245, 158, 11, 0.4);
  }
</style>

<script>
  const REFRESH_MS = 120000;
  let refreshTimer: number | undefined;

  function withCacheBust(base: string): string {
    const url = new URL(base, window.location.href);
    url.searchParams.set('t', String(Date.now()));
    return url.toString();
  }

  function showFallback(img: HTMLImageElement): void {
    img.classList.add('hidden');
    img.parentElement?.querySelector('[data-webcam-fallback]')?.classList.replace('hidden', 'flex');
  }

  function initializeWebcamSnapshots(): void {
    if (refreshTimer !== undefined) {
      window.clearInterval(refreshTimer);
      refreshTimer = undefined;
    }
    const imgs = document.querySelectorAll<HTMLImageElement>('img[data-webcam-refresh]');
    if (!imgs.length) return;

    imgs.forEach((img) => {
      if (img.dataset.bound === 'true') return;
      img.dataset.bound = 'true';
      img.addEventListener('error', () => showFallback(img));
      img.addEventListener('load', () => {
        img.classList.remove('hidden');
        img.parentElement?.querySelector('[data-webcam-fallback]')?.classList.replace('flex', 'hidden');
      });
      if (img.complete && img.naturalWidth === 0 && img.currentSrc) showFallback(img);
    });

    refreshTimer = window.setInterval(() => {
      if (document.hidden) return;
      document.querySelectorAll<HTMLImageElement>('img[data-webcam-refresh]').forEach((img) => {
        const base = img.dataset.baseSrc;
        if (base) img.src = withCacheBust(base);
      });
    }, REFRESH_MS);
  }

  (window as any).initializeWebcamSnapshots = initializeWebcamSnapshots;
  document.addEventListener('DOMContentLoaded', initializeWebcamSnapshots);
  if (document.readyState !== 'loading') initializeWebcamSnapshots();

  const hookSnapshots = () => {
    const swup = (window as any).swup;
    if (!swup?.hooks || (window as any).__webcamSnapshotsHooked) return;
    (window as any).__webcamSnapshotsHooked = true;
    swup.hooks.on('page:view', () => (window as any).initializeWebcamSnapshots?.());
    swup.hooks.on('visit:end', () => (window as any).initializeWebcamSnapshots?.());
  };
  hookSnapshots();
  document.addEventListener('DOMContentLoaded', hookSnapshots);
</script>
