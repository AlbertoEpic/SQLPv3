---
const token = import.meta.env.PUBLIC_INSTAGRAM_ACCESS_TOKEN;
---

<section class="instagram-contenedor">
  <h2>Sígueme en Instagram</h2>
  <div id="instafeed" class="instagram-grid" data-token={token}></div>
</section>

<script is:inline src="https://cdn.jsdelivr.net/gh/stevenschobert/instafeed.js@2.0.0/dist/instafeed.min.js"></script>

<script is:inline>
  function loadInstagram() {
    const feedContainer = document.getElementById('instafeed');
    if (!feedContainer) return;

    feedContainer.innerHTML = '';

    const instagramToken = feedContainer.dataset.token;
    if (!instagramToken) return;

    const feed = new Instafeed({
      accessToken: instagramToken,
      limit: 6,
      template: '<a href="{{link}}" target="_blank" class="instagram-tarjeta"><img src="{{image}}" alt="{{caption}}" /></a>',
    });

    feed.run();
  }

  document.addEventListener('DOMContentLoaded', loadInstagram);
  document.addEventListener('astro:after-swap', loadInstagram);
</script>

<style>
  .instagram-contenedor {
    margin: 40px auto;
    max-width: 1000px;
    padding: 0 20px;
  }
  .instagram-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 16px;
    margin-top: 20px;
  }
  .instagram-tarjeta {
    overflow: hidden;
    border-radius: 8px;
    aspect-ratio: 1 / 1;
    display: block;
  }
  .instagram-tarjeta img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .instagram-tarjeta:hover img {
    transform: scale(1.05);
  }
</style>