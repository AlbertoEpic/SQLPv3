---
/**
 * StravaRouteMap.astro
 *
 * Muestra automáticamente el mapa Leaflet con el GPX de Strava que mejor
 * coincide con el post actual (por título, slug y fecha de publicación).
 *
 * Requiere que los archivos GPX estén en public/gpx/strava/ junto con el
 * index.json generado por scripts/download-strava-gpx.mjs.
 *
 * Para sobreescribir la asociación automática de un post, crea el archivo
 * public/gpx/strava/manual-links.json con el formato:
 *   { "mi-slug-de-post": "2024-05-10-nombre-actividad-12345.gpx" }
 */

export interface Props {
  postTitle: string;
  postSlug: string;
  publishDate?: string;
}

import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';

const { postTitle, postSlug, publishDate } = Astro.props;

function normalizeText(value: string): string {
  return String(value || '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9\s-]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

function tokenSet(value: string): Set<string> {
  return new Set(
    normalizeText(value)
      .split(' ')
      .filter((token) => token.length >= 3)
  );
}

function scoreCandidate(entry: any, title: string, slug: string, date?: string): number {
  const nameTokens = tokenSet(entry?.name || '');
  const postTokens = tokenSet(title);
  const slugTokens = tokenSet(slug.replaceAll('-', ' '));

  let score = 0;

  for (const token of postTokens) {
    if (nameTokens.has(token)) score += 3;
  }

  for (const token of slugTokens) {
    if (nameTokens.has(token)) score += 2;
  }

  const fileNorm = normalizeText(entry?.file || '');
  const slugNorm = normalizeText(slug.replaceAll('-', ' '));
  if (slugNorm && fileNorm.includes(slugNorm)) score += 8;

  if (date && entry?.start_date) {
    const days = Math.abs(new Date(date).getTime() - new Date(entry.start_date).getTime()) / (1000 * 60 * 60 * 24);
    if (days <= 7) score += 5;
    else if (days <= 30) score += 3;
    else if (days <= 90) score += 1;
  }

  return score;
}

function findBestMatch(index: any[], title: string, slug: string, date?: string) {
  let best = null;
  let bestScore = -1;

  for (const entry of index) {
    if (!entry || !entry.file || entry.status === 'error' || entry.status === 'no_stream_data') continue;
    const score = scoreCandidate(entry, title, slug, date);
    if (score > bestScore) {
      best = entry;
      bestScore = score;
    }
  }

  return bestScore >= 4 ? best : null;
}

const stravaDir = join(process.cwd(), 'public', 'gpx', 'strava');
const indexPath = join(stravaDir, 'index.json');
const manualLinksPath = join(stravaDir, 'manual-links.json');

let matchedEntry: any = null;

if (existsSync(indexPath)) {
  try {
    const index = JSON.parse(readFileSync(indexPath, 'utf8'));
    const manualLinks = existsSync(manualLinksPath)
      ? JSON.parse(readFileSync(manualLinksPath, 'utf8'))
      : {};
    const manualFile = manualLinks?.[postSlug];

    matchedEntry = typeof manualFile === 'string'
      ? index.find((entry: any) => entry && entry.file === manualFile) || null
      : findBestMatch(index, postTitle, postSlug, publishDate);
  } catch {
    matchedEntry = null;
  }
}
---

{matchedEntry && (
<style is:global>
  #strava-map-fullscreen-shell:fullscreen,
  #strava-map-fullscreen-shell:-webkit-full-screen,
  #strava-map-fullscreen-shell:-moz-full-screen {
    height: 100vh !important;
    width: 100vw !important;
    background: #0f172a;
    padding: 0.75rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: stretch;
    justify-content: flex-start;
  }

  #strava-map-fullscreen-shell:fullscreen #strava-map-canvas,
  #strava-map-fullscreen-shell:-webkit-full-screen #strava-map-canvas,
  #strava-map-fullscreen-shell:-moz-full-screen #strava-map-canvas {
    flex: 1 1 auto;
    min-height: 0;
    height: auto !important;
    border-radius: 0 !important;
  }

  #strava-map-fullscreen-shell:fullscreen #strava-elevation-wrap,
  #strava-map-fullscreen-shell:-webkit-full-screen #strava-elevation-wrap,
  #strava-map-fullscreen-shell:-moz-full-screen #strava-elevation-wrap {
    display: block !important;
    margin-top: 0;
    flex: 0 0 auto;
  }

  #strava-map-fullscreen-shell:fullscreen #strava-elevation-canvas,
  #strava-map-fullscreen-shell:-webkit-full-screen #strava-elevation-canvas,
  #strava-map-fullscreen-shell:-moz-full-screen #strava-elevation-canvas {
    height: 120px !important;
  }
</style>

<section class="mx-auto mt-8 not-prose">
  <div class="rounded-xl border border-primary-200 dark:border-primary-700 bg-primary-50 dark:bg-primary-900 p-4 shadow-sm">
    <div class="mb-3 flex items-center justify-between gap-3">
      <h2 class="text-lg font-semibold text-primary-900 dark:text-primary-50">
        Ruta <span id="strava-map-status" class="text-base font-normal text-primary-500 dark:text-primary-400">Buscando GPX asociado...</span>
      </h2>
      <a
        id="strava-map-download"
        class="hidden text-sm font-medium text-highlight-600 dark:text-highlight-400 hover:underline"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
      >
        Descargar GPX
      </a>
    </div>

    <div id="strava-map-stats" class="mb-3 hidden">
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
        <div class="rounded-lg bg-primary-100 dark:bg-primary-800 px-3 py-2 text-center">
          <div id="stat-distance" class="text-base font-bold text-primary-900 dark:text-primary-50">—</div>
          <div class="text-xs text-primary-500 dark:text-primary-400">Distancia</div>
        </div>
        <div class="rounded-lg bg-primary-100 dark:bg-primary-800 px-3 py-2 text-center">
          <div id="stat-gain" class="text-base font-bold text-emerald-600 dark:text-emerald-400">—</div>
          <div class="text-xs text-primary-500 dark:text-primary-400">Desnivel +</div>
        </div>
        <div class="rounded-lg bg-primary-100 dark:bg-primary-800 px-3 py-2 text-center">
          <div id="stat-loss" class="text-base font-bold text-orange-500 dark:text-orange-400">—</div>
          <div class="text-xs text-primary-500 dark:text-primary-400">Desnivel −</div>
        </div>
        <div class="rounded-lg bg-primary-100 dark:bg-primary-800 px-3 py-2 text-center">
          <div id="stat-time" class="text-base font-bold text-blue-600 dark:text-blue-400">—</div>
          <div class="text-xs text-primary-500 dark:text-primary-400">Tiempo</div>
        </div>
      </div>
    </div>

    <div id="strava-map-fullscreen-shell">
      <div
        id="strava-map-canvas"
        data-gpx-file={matchedEntry.file}
        data-gpx-name={matchedEntry.name || matchedEntry.file}
        data-base-url={import.meta.env.BASE_URL}
        class="aspect-[2/1] w-full overflow-hidden rounded-lg bg-primary-100 dark:bg-primary-800"
      ></div>

      <div id="strava-elevation-wrap" class="relative mt-2 hidden">
        <canvas id="strava-elevation-canvas" height="100" class="w-full cursor-crosshair rounded-lg"></canvas>
        <div
          id="strava-elev-tooltip"
          class="pointer-events-none absolute hidden -translate-x-1/2 rounded bg-primary-900/90 px-2 py-1 text-xs text-white shadow-lg"
          style="top:4px"
        ></div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const stateKey = '__stravaMapState';

  if (!window[stateKey]) {
    window[stateKey] = { assetsReady: null, swapBound: false };
  }

  const stravaMapState = window[stateKey];

  async function loadScript(src) {
    return new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = src;
      s.async = true;
      s.onload = () => resolve(true);
      s.onerror = () => reject(new Error(`No se pudo cargar ${src}`));
      document.head.appendChild(s);
    });
  }

  async function loadScriptWithFallback(sources) {
    let lastError = null;
    for (const src of sources) {
      try { await loadScript(src); return; } catch (err) { lastError = err; }
    }
    throw lastError || new Error('No se pudo cargar ninguna fuente.');
  }

  async function ensureLeafletAssets() {
    if (stravaMapState.assetsReady) return stravaMapState.assetsReady;

    stravaMapState.assetsReady = (async () => {
      if (!document.getElementById('strava-leaflet-css')) {
        const link = document.createElement('link');
        link.id = 'strava-leaflet-css';
        link.rel = 'stylesheet';
        link.href = 'https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css';
        document.head.appendChild(link);
      }

      if (!window.L) {
        await loadScriptWithFallback([
          'https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js',
          'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js',
        ]);
      }

      if (!window.GPX && !(window.L && window.L.GPX)) {
        await loadScriptWithFallback([
          'https://cdn.jsdelivr.net/npm/leaflet-gpx@2.1.2/gpx.min.js',
          'https://unpkg.com/leaflet-gpx@2.1.2/gpx.min.js',
        ]);
      }
    })();

    return stravaMapState.assetsReady;
  }

  // ---------- Matching helpers ----------

  // ---------- UI helpers ----------

  function formatTime(ms) {
    if (!ms || ms <= 0) return '—';
    const s = Math.round(ms / 1000);
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    return h > 0 ? `${h}h ${m}m` : `${m}m`;
  }

  // ---------- Elevation chart ----------

  function setupElevationChart(elevData, trackPoints, map) {
    const wrap = document.getElementById('strava-elevation-wrap');
    const canvas = document.getElementById('strava-elevation-canvas');
    const tooltipEl = document.getElementById('strava-elev-tooltip');
    if (!wrap || !canvas || !elevData || elevData.length < 2) return;

    wrap.classList.remove('hidden');

    const elevations = elevData.map((p) => p[1]);
    const distances = elevData.map((p) => p[0]);
    const minE = Math.min(...elevations);
    const maxE = Math.max(...elevations);
    const maxD = distances[distances.length - 1];
    const rangeE = maxE - minE || 1;
    const pad = { top: 8, right: 8, bottom: 18, left: 42 };
    let dpr = 1, w = 0, h = 0, cw = 0, ch = 0, ctx = null;

    function syncCanvasSize() {
      const rect = canvas.getBoundingClientRect();
      const nextW = Math.max(240, Math.round(rect.width || canvas.parentElement.offsetWidth || 600));
      const nextH = Math.max(80, Math.round(rect.height || 100));
      dpr = window.devicePixelRatio || 1;
      w = nextW; h = nextH;
      cw = w - pad.left - pad.right;
      ch = h - pad.top - pad.bottom;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx = canvas.getContext('2d');
      if (ctx) ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function drawBase(hoverPoint) {
      if (!ctx) return;
      const dark = document.documentElement.classList.contains('dark');
      const bgColor = dark ? '#1e293b' : '#f8fafc';
      const labelColor = dark ? '#64748b' : '#94a3b8';
      const fillTop = dark ? 'rgba(14,165,233,0.35)' : 'rgba(14,165,233,0.4)';
      const fillBot = dark ? 'rgba(14,165,233,0.02)' : 'rgba(14,165,233,0.05)';

      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = bgColor;
      ctx.beginPath();
      if (ctx.roundRect) ctx.roundRect(0, 0, w, h, 8); else ctx.rect(0, 0, w, h);
      ctx.fill();

      const grad = ctx.createLinearGradient(0, pad.top, 0, pad.top + ch);
      grad.addColorStop(0, fillTop);
      grad.addColorStop(1, fillBot);
      ctx.beginPath();
      for (let i = 0; i < elevData.length; i++) {
        const x = pad.left + (distances[i] / maxD) * cw;
        const y = pad.top + ch - ((elevations[i] - minE) / rangeE) * ch;
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      }
      ctx.lineTo(pad.left + cw, pad.top + ch);
      ctx.lineTo(pad.left, pad.top + ch);
      ctx.closePath();
      ctx.fillStyle = grad;
      ctx.fill();

      ctx.beginPath();
      for (let i = 0; i < elevData.length; i++) {
        const x = pad.left + (distances[i] / maxD) * cw;
        const y = pad.top + ch - ((elevations[i] - minE) / rangeE) * ch;
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      }
      ctx.strokeStyle = '#0ea5e9';
      ctx.lineWidth = 1.5;
      ctx.lineJoin = 'round';
      ctx.lineCap = 'round';
      ctx.stroke();

      ctx.fillStyle = labelColor;
      ctx.font = '10px system-ui, sans-serif';
      ctx.textAlign = 'right';
      ctx.fillText(`${Math.round(maxE)}m`, pad.left - 4, pad.top + 8);
      ctx.fillText(`${Math.round(minE)}m`, pad.left - 4, pad.top + ch);
      ctx.textAlign = 'left';
      ctx.fillText('0', pad.left, h - 3);
      ctx.textAlign = 'right';
      ctx.fillText(`${maxD.toFixed(1)} km`, pad.left + cw, h - 3);

      if (hoverPoint) {
        const xi = hoverPoint.x;
        const yi = hoverPoint.y;
        ctx.beginPath();
        ctx.moveTo(xi, pad.top);
        ctx.lineTo(xi, pad.top + ch);
        ctx.strokeStyle = dark ? 'rgba(255,255,255,0.35)' : 'rgba(0,0,0,0.2)';
        ctx.lineWidth = 1;
        ctx.setLineDash([3, 3]);
        ctx.stroke();
        ctx.setLineDash([]);
        ctx.beginPath();
        ctx.arc(xi, yi, 4, 0, Math.PI * 2);
        ctx.fillStyle = '#ef4444';
        ctx.fill();
        ctx.strokeStyle = '#fff';
        ctx.lineWidth = 1.5;
        ctx.stroke();
      }
    }

    function sampleAtDistance(distValue) {
      const d = Math.max(0, Math.min(maxD, distValue));
      let hi = 1;
      while (hi < distances.length && distances[hi] < d) hi += 1;
      if (hi >= distances.length) hi = distances.length - 1;
      const lo = Math.max(0, hi - 1);
      const d0 = distances[lo], d1 = distances[hi];
      const e0 = elevations[lo], e1 = elevations[hi];
      const t = d1 === d0 ? 0 : (d - d0) / (d1 - d0);
      const elev = e0 + (e1 - e0) * t;
      return { distKm: d, elevM: elev, x: pad.left + (d / maxD) * cw, y: pad.top + ch - ((elev - minE) / rangeE) * ch };
    }

    syncCanvasSize();
    drawBase(null);

    let hoverMarker = null;
    if (map) {
      hoverMarker = window.L.circleMarker([0, 0], {
        radius: 7, color: '#fff', weight: 2.5,
        fillColor: '#ef4444', fillOpacity: 0, opacity: 0, interactive: false,
      }).addTo(map);
    }

    function findTrackPoint(distValue) {
      if (!trackPoints || trackPoints.length === 0) return null;
      let best = 0;
      let bestDiff = Math.abs(trackPoints[0].dist - distValue);
      for (let i = 1; i < trackPoints.length; i++) {
        const diff = Math.abs(trackPoints[i].dist - distValue);
        if (diff < bestDiff) { bestDiff = diff; best = i; }
      }
      return trackPoints[best];
    }

    function onMouseMove(e) {
      const rect = canvas.getBoundingClientRect();
      if (Math.abs(rect.width - w) > 1 || Math.abs(rect.height - h) > 1) syncCanvasSize();
      const mx = e.clientX - rect.left;
      if (mx < pad.left || mx > pad.left + cw) { onMouseLeave(); return; }
      const distValue = ((mx - pad.left) / cw) * maxD;
      const hp = sampleAtDistance(distValue);
      drawBase(hp);
      const tp = findTrackPoint(hp.distKm * 1000);
      if (hoverMarker && tp) { hoverMarker.setLatLng([tp.lat, tp.lng]); hoverMarker.setStyle({ opacity: 1, fillOpacity: 1 }); }
      if (tooltipEl) {
        tooltipEl.innerHTML = `<span style="color:#94a3b8">${hp.distKm.toFixed(2)}&thinsp;km</span><span style="color:#94a3b8"> · </span><span style="color:#38bdf8">${Math.round(hp.elevM)}&thinsp;m</span>`;
        const clampedX = Math.max(pad.left + 28, Math.min(hp.x, cw + pad.left - 28));
        tooltipEl.style.left = clampedX + 'px';
        tooltipEl.classList.remove('hidden');
      }
    }

    function onMouseLeave() {
      drawBase(null);
      if (hoverMarker) hoverMarker.setStyle({ opacity: 0, fillOpacity: 0 });
      if (tooltipEl) tooltipEl.classList.add('hidden');
    }

    canvas.addEventListener('mousemove', onMouseMove);
    canvas.addEventListener('mouseleave', onMouseLeave);

    const onResize = () => { syncCanvasSize(); drawBase(null); if (tooltipEl) tooltipEl.classList.add('hidden'); if (hoverMarker) hoverMarker.setStyle({ opacity: 0, fillOpacity: 0 }); };
    window.addEventListener('resize', onResize);
    document.addEventListener('fullscreenchange', onResize);
    document.addEventListener('webkitfullscreenchange', onResize);
  }

  // ---------- Fullscreen control ----------

  function addFullscreenControl(map, fullscreenEl) {
    const FullscreenControl = window.L.Control.extend({
      options: { position: 'topleft' },
      onAdd() {
        const container = window.L.DomUtil.create('div', 'leaflet-bar leaflet-control');
        const btn = window.L.DomUtil.create('a', '', container);
        btn.href = '#';
        btn.title = 'Pantalla completa';
        btn.setAttribute('role', 'button');
        btn.setAttribute('aria-label', 'Pantalla completa');
        btn.style.cssText = 'display:flex;align-items:center;justify-content:center;width:30px;height:30px;color:#444;text-decoration:none;';

        const iconExpand = '<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>';
        const iconCompress = '<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"/></svg>';
        btn.innerHTML = iconExpand;

        window.L.DomEvent.on(btn, 'click', (e) => {
          window.L.DomEvent.preventDefault(e);
          window.L.DomEvent.stopPropagation(e);
          if (!document.fullscreenElement) {
            (fullscreenEl.requestFullscreen || fullscreenEl.webkitRequestFullscreen || (() => {})).call(fullscreenEl);
          } else {
            (document.exitFullscreen || document.webkitExitFullscreen || (() => {})).call(document);
          }
        });

        const onFsChange = () => {
          const isFullscreen = document.fullscreenElement === fullscreenEl;
          if (isFullscreen) {
            const chartWrap = document.getElementById('strava-elevation-wrap');
            const chartCanvas = document.getElementById('strava-elevation-canvas');
            const chartHeight = chartWrap && !chartWrap.classList.contains('hidden') ? 140 : 0;
            const mapHeight = Math.max(320, window.innerHeight - chartHeight - 52);
            fullscreenEl.style.display = 'flex';
            fullscreenEl.style.flexDirection = 'column';
            fullscreenEl.style.gap = '0.5rem';
            const mapEl = document.getElementById('strava-map-canvas');
            if (mapEl) mapEl.style.height = `${mapHeight}px`;
            if (chartCanvas && chartHeight > 0) chartCanvas.style.height = `${chartHeight}px`;
          } else {
            fullscreenEl.style.display = '';
            fullscreenEl.style.flexDirection = '';
            fullscreenEl.style.gap = '';
            const mapEl = document.getElementById('strava-map-canvas');
            const chartCanvas = document.getElementById('strava-elevation-canvas');
            if (mapEl) mapEl.style.height = '';
            if (chartCanvas) chartCanvas.style.height = '';
          }
          setTimeout(() => map.invalidateSize(), 60);
          setTimeout(() => map.invalidateSize(), 240);
          btn.innerHTML = isFullscreen ? iconCompress : iconExpand;
          btn.title = isFullscreen ? 'Salir de pantalla completa' : 'Pantalla completa';
        };

        document.addEventListener('fullscreenchange', onFsChange);
        document.addEventListener('webkitfullscreenchange', onFsChange);
        return container;
      },
    });
    new FullscreenControl().addTo(map);
  }

  // ---------- Main mount ----------

  async function mountStravaMap() {
    const canvas = document.getElementById('strava-map-canvas');
    const status = document.getElementById('strava-map-status');
    const download = document.getElementById('strava-map-download');
    const statsEl = document.getElementById('strava-map-stats');
    const elevWrap = document.getElementById('strava-elevation-wrap');
    const fullscreenShell = document.getElementById('strava-map-fullscreen-shell');

    if (!canvas || !status || !download) return;

    if (statsEl) statsEl.classList.add('hidden');
    if (elevWrap) elevWrap.classList.add('hidden');

    const gpxFile = canvas.dataset.gpxFile || '';
    const gpxName = canvas.dataset.gpxName || gpxFile;
    const baseUrl = canvas.dataset.baseUrl || '/';

    function withBase(path) {
      const normalizedBase = String(baseUrl).endsWith('/') ? String(baseUrl) : `${String(baseUrl)}/`;
      const normalizedPath = String(path || '').replace(/^\/+/, '');
      return `${normalizedBase}${normalizedPath}`;
    }

    try {
      if (!gpxFile) return;

      const gpxUrl = withBase(`gpx/strava/${gpxFile}`);
      download.href = gpxUrl;
      download.classList.remove('hidden');
      status.textContent = gpxName;

      await ensureLeafletAssets();
      const GPXConstructor = window.GPX || (window.L && window.L.GPX);
      if (!GPXConstructor) throw new Error('leaflet-gpx no se cargó.');

      canvas.innerHTML = '';

      const map = window.L.map(canvas, { scrollWheelZoom: false, zoomControl: true });

      const layerTopo = window.L.tileLayer('https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png', {
        maxZoom: 17,
        attribution: '&copy; <a href="https://opentopomap.org" target="_blank">OpenTopoMap</a> &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank">OpenStreetMap</a>',
      });
      const layerOSM = window.L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank">OpenStreetMap</a>',
      });
      const layerSatellite = window.L.tileLayer(
        'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
          maxZoom: 19,
          attribution: '&copy; <a href="https://www.esri.com" target="_blank">Esri</a>',
        }
      );

      layerTopo.addTo(map);
      window.L.control.layers(
        { 'Topográfico': layerTopo, 'Estándar': layerOSM, 'Satélite': layerSatellite },
        {}, { position: 'topright', collapsed: true }
      ).addTo(map);

      addFullscreenControl(map, fullscreenShell || canvas);

      new GPXConstructor(gpxUrl, {
        async: true,
        marker_options: { startIconUrl: null, endIconUrl: null, shadowUrl: null },
        polyline_options: { color: '#ef4444', opacity: 1, weight: 4, lineCap: 'round', lineJoin: 'round' },
      })
        .on('loaded', function (e) {
          const gpx = e.target;
          map.fitBounds(gpx.getBounds(), { padding: [24, 24] });
          setTimeout(() => map.invalidateSize(), 50);

          try {
            const distM = gpx.get_distance ? gpx.get_distance() : null;
            const gainM = gpx.get_elevation_gain ? gpx.get_elevation_gain() : null;
            const lossM = gpx.get_elevation_loss ? gpx.get_elevation_loss() : null;
            const timeMs = gpx.get_moving_time ? gpx.get_moving_time() : null;

            if (statsEl && (distM || gainM)) {
              const setVal = (id, val) => { const el = document.getElementById(id); if (el && val !== null) el.textContent = val; };
              setVal('stat-distance', distM !== null ? `${(distM / 1000).toFixed(1)} km` : null);
              setVal('stat-gain', gainM !== null ? `+${Math.round(gainM)} m` : null);
              setVal('stat-loss', lossM !== null ? `−${Math.round(lossM)} m` : null);
              setVal('stat-time', formatTime(timeMs));
              statsEl.classList.remove('hidden');
            }
          } catch (_) {}

          try {
            const elevData = gpx.get_elevation_data ? gpx.get_elevation_data() : null;
            if (elevData && elevData.length > 1) {
              const latlngs = [];
              function collectLatLngs(layer) {
                if (layer instanceof window.L.Polyline) {
                  const pts = layer.getLatLngs();
                  const flat = pts.length && Array.isArray(pts[0]) ? pts.flat(Infinity) : pts;
                  for (const p of flat) latlngs.push(p);
                } else if (typeof layer.eachLayer === 'function') {
                  layer.eachLayer(collectLatLngs);
                }
              }
              collectLatLngs(gpx);

              const rawPoints = gpx._info && gpx._info.elevation && gpx._info.elevation._points;
              const trackPoints = [];
              if (rawPoints && latlngs.length === rawPoints.length) {
                for (let i = 0; i < rawPoints.length; i++) {
                  trackPoints.push({ lat: latlngs[i].lat, lng: latlngs[i].lng, dist: rawPoints[i][0] });
                }
              } else if (latlngs.length > 0) {
                trackPoints.push({ lat: latlngs[0].lat, lng: latlngs[0].lng, dist: 0 });
                for (let i = 1; i < latlngs.length; i++) {
                  const d = trackPoints[i - 1].dist + latlngs[i - 1].distanceTo(latlngs[i]);
                  trackPoints.push({ lat: latlngs[i].lat, lng: latlngs[i].lng, dist: d });
                }
              }
              setupElevationChart(elevData, trackPoints, map);
            }
          } catch (_) {}
        })
        .on('error', function () { status.textContent = 'No se pudo cargar el GPX.'; })
        .addTo(map);
    } catch (_) {
      status.textContent = 'Error cargando el mapa.';
    }
  }

  mountStravaMap();

  // Re-mount after Swup page transitions (used by this blog theme)
  if (!stravaMapState.swapBound) {
    stravaMapState.swapBound = true;
    document.addEventListener('swup:page:view', mountStravaMap);
  }
</script>
)}
