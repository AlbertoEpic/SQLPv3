---
import BaseLayout from '@/layouts/BaseLayout.astro';
import WebcamMap from '@/components/WebcamMap.astro';
import WebcamCard from '@/components/WebcamCard.astro';
import WebcamLightbox from '@/components/WebcamLightbox.astro';
import webcams from '@/data/webcams.json';
import { withBase } from '@/utils/base-url';

const categories = ["Todas", "Pirineo Oscense", "Provincia de Huesca", "Carreteras DGT", "Otros Pirineos", "Otras zonas", "Mundo"];

const kinds = ["Estación de esquí", "Refugio de montaña", "Enclaves del Pirineo", "DGT-carreteras", "Otras"];
const skiPattern = /^(cerler-(cota|ampriu)|formigal|panticosa-petrosos|piau-engaly|baqueira|breuil|mieders|llanos-del-hospital|linza-esqui-fondo)/;
const enclavePattern = /^(cascada|portalet|tunnel-bielsa|riglos|nocito|alquezar|montfalco)/;

function getKind(cam: { id: string; type: string; sourceName: string }) {
  if (cam.type === 'dgt') return 'DGT-carreteras';
  if (skiPattern.test(cam.id)) return 'Estación de esquí';
  if (enclavePattern.test(cam.id)) return 'Enclaves del Pirineo';
  if (cam.sourceName.startsWith('Albergues y refugios')) return 'Refugio de montaña';
  return 'Otras';
}

const seoData = {
  title: 'Webcams en directo',
  description: 'Webcams en directo del Pirineo Oscense, la provincia de Huesca y el mundo.',
  canonical: new URL('/webcams', Astro.site ?? 'http://localhost:5000').toString(),
  ogType: 'website' as const,
};
---

<BaseLayout seoData={seoData}>
  <main class="webcams-cover w-full pb-14">
    <section class="webcams-fullbleed relative min-h-48 overflow-hidden border-b border-primary-200/80 dark:border-primary-700/70 md:min-h-64" aria-label="Paisaje alpino">
      <div class="webcams-hero-bg absolute inset-0" style={`background-image: url('${withBase('/Webcams en paisajes alpinos.png')}')`} aria-hidden="true"></div>
      <div class="webcams-hero-overlay absolute inset-0" aria-hidden="true"></div>
    </section>

    <section class="mt-6 px-4 sm:px-6 lg:px-10">
      <p class="mt-2 text-left text-base text-primary-700 dark:text-primary-200 sm:text-lg">
        Mira cómo está el tiempo ahora mismo en el Pirineo, Huesca y el Mundo. Y es que una imagen vale más que mil palabras. En esta sección puedes comprobar el estado del tráfico en las carreteras, la meteo en puntos clave del Pirineo, la innivación de las estaciones de esquí,... Incluso asomarte al mundo en algunos rincones míticos!
      </p>
    </section>

    <section class="mt-6 px-4 sm:px-6 lg:px-10">
      <div class="webcams-island">
        <WebcamMap webcams={webcams} />
      </div>
    </section>

    <section class="px-4 sm:px-6 lg:px-10 mt-6">
      <form id="webcam-search" class="flex flex-col gap-3 sm:flex-row" role="search" aria-label="Buscar webcams" onsubmit="return false">
        <input
          id="webcam-search-name"
          type="search"
          placeholder="Por nombre"
          aria-label="Buscar webcam por nombre"
          autocomplete="off"
          class="w-full rounded-xl border border-primary-200 bg-primary-50/80 px-4 py-2 text-sm text-primary-800 placeholder:text-primary-500 focus:border-highlight-500 focus:outline-none dark:border-primary-700 dark:bg-primary-900/60 dark:text-primary-100 dark:placeholder:text-primary-400 sm:flex-1"
        />
        <select
          id="webcam-search-kind"
          aria-label="Filtrar por tipo"
          class="w-full rounded-xl border border-primary-200 bg-primary-50/80 px-4 py-2 text-sm text-primary-800 focus:border-highlight-500 focus:outline-none dark:border-primary-700 dark:bg-primary-900/60 dark:text-primary-100 sm:w-64"
        >
          <option value="">Por tipo: todos</option>
          {kinds.map((k) => <option value={k}>{k}</option>)}
        </select>
      </form>
    </section>

    <section class="px-4 sm:px-6 lg:px-10 mt-6">
      <div class="mb-6 flex flex-wrap gap-2" role="group" aria-label="Filtrar por categoría">
        {categories.map((cat, i) => (
          <button
            type="button"
            data-filter={cat}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="webcam-filter rounded-xl border border-primary-200 bg-primary-50/80 px-4 py-2 text-sm font-semibold text-primary-800 transition-colors hover:border-highlight-500 hover:text-highlight-700 aria-pressed:border-highlight-400 aria-pressed:bg-highlight-600 aria-pressed:text-primary-50 dark:border-primary-700 dark:bg-primary-900/60 dark:text-primary-100 dark:hover:text-highlight-300"
          >
            {cat}
          </button>
        ))}
      </div>

      <div id="webcam-grid" class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {webcams.map((cam) => (
          <WebcamCard
            id={cam.id}
            title={cam.title}
            location={cam.location}
            category={cam.category}
            kind={getKind(cam)}
            type={cam.type as 'youtube' | 'iframe' | 'dgt' | 'snapshot' | 'hls' | 'mjpeg'}
            embedUrl={cam.embedUrl}
            sourceName={cam.sourceName}
            sourceUrl={cam.sourceUrl}
          />
        ))}
      </div>
      <p id="webcam-empty" class="hidden py-10 text-center text-primary-600 dark:text-primary-300">No hay cámaras que coincidan con la búsqueda.</p>
    </section>
  </main>
  <WebcamLightbox />
</BaseLayout>

<style>
  .webcams-cover {
    background:
      radial-gradient(1200px 380px at 20% -5%, rgb(var(--color-highlight-500) / 0.22), transparent 60%),
      radial-gradient(1000px 420px at 95% 0%, rgb(var(--color-primary-700) / 0.18), transparent 62%),
      rgb(var(--color-primary-50));
  }
  :global(.dark) .webcams-cover {
    background:
      radial-gradient(1200px 380px at 20% -5%, rgb(var(--color-highlight-500) / 0.2), transparent 60%),
      radial-gradient(1000px 420px at 95% 0%, rgb(var(--color-primary-200) / 0.08), transparent 62%),
      rgb(var(--color-primary-950));
  }
  .webcams-fullbleed {
    position: relative;
    left: 50%;
    right: 50%;
    width: 100vw;
    max-width: 100vw;
    margin-left: -50vw;
    margin-right: -50vw;
  }
  @supports (width: 100dvw) {
    .webcams-fullbleed {
      width: 100dvw;
      max-width: 100dvw;
      margin-left: -50dvw;
      margin-right: -50dvw;
    }
  }
  .webcams-hero-bg {
    background-size: cover;
    background-position: center;
    filter: saturate(1.15);
  }
  .webcams-hero-overlay {
    background: linear-gradient(180deg, rgb(var(--color-primary-900) / 0.08), rgb(var(--color-primary-950) / 0.38));
  }
  .webcams-title {
    font-family: 'Mouse Memoirs', sans-serif !important;
    font-weight: 400;
    font-size: 4rem;
  }
  .webcams-island {
    border: 1px solid rgb(var(--color-primary-200));
    background: rgb(var(--color-primary-50) / 0.8);
    border-radius: 1rem;
    padding: 1rem;
    box-shadow: 0 14px 35px rgb(var(--color-primary-900) / 0.07);
  }
  :global(.dark) .webcams-island {
    border-color: rgb(var(--color-primary-700));
    background: rgb(var(--color-primary-900) / 0.62);
  }
</style>
<script>
  function initializeWebcamFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.webcam-filter');
    const cards = document.querySelectorAll<HTMLElement>('[data-webcam-card]');
    const empty = document.getElementById('webcam-empty');
    const nameInput = document.getElementById('webcam-search-name') as HTMLInputElement | null;
    const kindSelect = document.getElementById('webcam-search-kind') as HTMLSelectElement | null;
    if (!buttons.length) return;

    const normalize = (s: string) => s.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase().trim();

    const applyFilters = () => {
      const active = document.querySelector<HTMLButtonElement>('.webcam-filter[aria-pressed="true"]');
      const filter = active?.dataset.filter ?? 'Todas';
      const query = normalize(nameInput?.value ?? '');
      const kind = kindSelect?.value ?? '';
      let visible = 0;
      cards.forEach((card) => {
        const cat = card.dataset.category;
        const matchesCategory =
          filter === 'Todas' ||
          cat === filter ||
          (filter === 'Provincia de Huesca' && (cat === 'Pirineo Oscense' || cat === 'Provincia de Huesca' || cat === 'Carreteras DGT'));
        const matchesName = !query || normalize(`${card.dataset.title ?? ''} ${card.dataset.location ?? ''}`).includes(query);
        const matchesKind = !kind || card.dataset.kind === kind;
        const show = matchesCategory && matchesName && matchesKind;
        card.classList.toggle('hidden', !show);
        if (show) visible++;
      });
      empty?.classList.toggle('hidden', visible > 0);
      const filtered = visible !== cards.length;
      const ids = Array.from(cards)
        .filter((c) => !c.classList.contains('hidden'))
        .map((c) => c.id.replace(/^webcam-/, ''));
      (window as any).setWebcamMapVisibleIds?.(filtered ? ids : null);
    };

    buttons.forEach((btn) => {
      const fresh = btn.cloneNode(true) as HTMLButtonElement;
      btn.replaceWith(fresh);
      fresh.addEventListener('click', () => {
        document.querySelectorAll<HTMLButtonElement>('.webcam-filter').forEach((b) =>
          b.setAttribute('aria-pressed', String(b === fresh))
        );
        applyFilters();
      });
    });

    [nameInput, kindSelect].forEach((el) => {
      if (!el || el.dataset.bound === 'true') return;
      el.dataset.bound = 'true';
      el.addEventListener('input', applyFilters);
    });
    applyFilters();
  }

  (window as any).initializeWebcamFilters = initializeWebcamFilters;
  document.addEventListener('DOMContentLoaded', initializeWebcamFilters);
  if (document.readyState !== 'loading') initializeWebcamFilters();

  const hookFilters = () => {
    const swup = (window as any).swup;
    if (!swup?.hooks || (window as any).__webcamFiltersHooked) return;
    (window as any).__webcamFiltersHooked = true;
    swup.hooks.on('page:view', () => (window as any).initializeWebcamFilters?.());
    swup.hooks.on('visit:end', () => (window as any).initializeWebcamFilters?.());
  };
  hookFilters();
  document.addEventListener('DOMContentLoaded', hookFilters);
</script>
